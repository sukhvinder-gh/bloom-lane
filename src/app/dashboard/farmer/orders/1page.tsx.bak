import { createClient } from '@/lib/supabase/server'
import { redirect } from 'next/navigation'
import OrderCard from '@/components/OrderCard'
import { formatPrice } from '@/lib/utils/pricing'
import { formatAEST } from '@/lib/utils/timezone'

export default async function FarmerOrdersPage() {
  const supabase = await createClient()
  
  // 1. Get Auth User
  const { data: { user } } = await supabase.auth.getUser()
  if (!user) redirect('/auth/login')

  // 2. Get Farmer Profile ID using maybeSingle() to avoid crashes
  const { data: farmerProfile, error: profileError } = await supabase
    .from('farmers')
    .select('id, farm_name')
    .eq('user_id', user.id)
    .maybeSingle();

  // If no profile exists yet
  if (!farmerProfile) {
    return (
      <div style={{ padding: '2.5rem', textAlign: 'center' }}>
        <h2 style={{ color: 'var(--forest)' }}>Farm Profile Not Found</h2>
        <p>Your account (ID: {user.id.substring(0,8)}...) isn't linked to a farm yet.</p>
      </div>
    );
  }

  // 3. Fetch Orders using the Farmer ID
  // Note: Using the 'inner' join syntax specifically for the farmer_id filter
  const { data: orders, error } = await supabase
    .from('orders')
    .select(`
      *,
      order_items!inner(
        id, 
        quantity, 
        products!inner(
          name, 
          farmer_id
        )
      )
    `)
    .eq('order_items.products.farmer_id', farmerProfile.id)
    .order('created_at', { ascending: false });

  if (error) {
    console.error('Database Join Error:', error.message);
    return (
      <div style={{ padding: '2.5rem' }}>
        <p>Error loading orders. Please check your database relationships.</p>
        <pre style={{ fontSize: '0.7rem', opacity: 0.5 }}>{error.message}</pre>
      </div>
    );
  }

  return (
    <div style={{ padding: '2.5rem', fontFamily: 'var(--font-body)' }}>
      <div style={{ marginBottom: '2rem' }}>
        <h1 style={{ fontFamily: 'var(--font-display)', fontSize: '2rem', color: 'var(--forest)' }}>
          Incoming Orders
        </h1>
        <p style={{ color: 'var(--forest)', opacity: 0.5 }}>
          Farm: <strong>{farmerProfile.farm_name}</strong> | {(orders || []).length} active orders
        </p>
      </div>

      {(!orders || orders.length === 0) ? (
        <div style={{ background: 'white', borderRadius: 'var(--r-card)', padding: '5rem', textAlign: 'center', border: '1px solid var(--olive)' }}>
          <div style={{ fontSize: '3rem', marginBottom: '1.25rem' }}>🚜</div>
          <p style={{ opacity: 0.5 }}>No orders have been placed for your products yet.</p>
        </div>
      ) : (
        <div style={{ display: 'flex', flexDirection: 'column', gap: '1rem' }}>
          {orders.map(order => (
            <OrderCard key={order.id} href={`/dashboard/farmer/orders/${order.id}`}>
              <div style={{ flex: '0 0 auto', minWidth: '8rem' }}>
                <p style={{ fontWeight: 'bold', color: 'var(--forest)' }}>{order.order_number}</p>
                <p style={{ fontSize: '0.75rem', opacity: 0.5 }}>
                  {formatAEST(order.created_at, 'dd MMM yyyy')}
                </p>
              </div>
              
              <div style={{ flex: 1 }}>
                {/* We only want to show the items that belong to THIS farmer */}
                {order.order_items
                  ?.filter((item: any) => item.products.farmer_id === farmerProfile.id)
                  .map((item: any) => (
                    <span key={item.id} style={{ display: 'block', fontSize: '0.85rem' }}>
                      {item.quantity}× {item.products?.name}
                    </span>
                ))}
              </div>

              <div style={{ flex: '0 0 auto', textAlign: 'right' }}>
                <span className="badge badge-sage" style={{ textTransform: 'capitalize' }}>
                  {order.status.replace('_', ' ')}
                </span>
                <p style={{ marginTop: '0.5rem', fontWeight: 'bold' }}>
                  {formatPrice(order.total_cents)}
                </p>
              </div>
            </OrderCard>
          ))}
        </div>
      )}
    </div>
  )
}