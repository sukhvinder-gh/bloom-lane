# ============================================================
# AGRI MARKETPLACE — Environment Variables
# Copy this to .env.local and fill in your values
# NEVER commit .env.local to git
# ============================================================

# ---- SUPABASE ----
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here   # Never expose to client

# ---- STRIPE ----
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...         # From: stripe listen --forward-to localhost:3000/api/webhooks/stripe

# ---- INNGEST ----
INNGEST_EVENT_KEY=your_inngest_event_key
INNGEST_SIGNING_KEY=your_inngest_signing_key

# ---- ABR (Australian Business Register) ----
# Free GUID from: https://abr.business.gov.au/Tools/WebServices
ABR_GUID=your_abr_guid_here

# ---- RESEND (email) ----
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=noreply@yourdomain.com.au

# ---- CLOUDINARY (farmer photos) ----
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ---- APP ----
NEXT_PUBLIC_APP_URL=http://localhost:3000   # Change to https://yourdomain.com.au in prod
NODE_ENV=development
