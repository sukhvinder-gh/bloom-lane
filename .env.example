# ============================================================
# AGRI MARKETPLACE — Environment Variables
# Copy this to .env.local and fill in your values
# NEVER commit .env.local to git
# ============================================================

# ---- SUPABASE ----
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here   # Never expose to client

# ---- STRIPE ----
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...         # From: stripe listen --forward-to localhost:3000/api/webhooks/stripe

# ---- INNGEST ----
INNGEST_EVENT_KEY=your_inngest_event_key
INNGEST_SIGNING_KEY=your_inngest_signing_key

# ---- ABR (Australian Business Register) ----
# Free GUID from: https://abr.business.gov.au/Tools/WebServices
ABR_GUID=your_abr_guid_here

# ---- EMAIL ----
# EMAIL_PROVIDER selects the sender explicitly ('resend' or 'gmail'). If unset,
# it's inferred as 'gmail' when GMAIL_USER + GMAIL_APP_PASSWORD are both set,
# else 'resend'. Resend's free sandbox sender can only deliver to the Resend
# account owner's own inbox, so Gmail SMTP is the interim path that actually
# reaches real users without a domain-verification step.
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_...
EMAIL_FROM=noreply@yourdomain.com.au
GMAIL_USER=youraddress@gmail.com
GMAIL_APP_PASSWORD=your_gmail_app_password

# ---- CLOUDINARY (farmer photos) ----
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ---- APP ----
NEXT_PUBLIC_APP_URL=http://localhost:3000     # Stripe Connect onboarding return/refresh URLs
NEXT_PUBLIC_SITE_URL=http://localhost:3000    # Links inside outbound emails — keep this equal to NEXT_PUBLIC_APP_URL
NEXT_PUBLIC_TEST_MODE=false                   # true bypasses Stripe entirely and auto-confirms orders — dev/testing only
CRON_SECRET=your_cron_secret_here             # Authenticates scheduled calls to admin cron-style routes
NODE_ENV=development
